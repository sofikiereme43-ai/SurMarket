<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentAddProduct"
    >
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fragment_padding">
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/CRV_FRGAddProductImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cardview_image_height"
        android:layout_marginBottom="@dimen/cardview_default_margin_botoom"
        app:cardBackgroundColor="@color/gray"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="@dimen/cardview_default_corner_radius_2"
        app:cardElevation="@dimen/cardview_default_elevation">
        <ImageView
            android:id="@+id/IMV_FRGAddProduct_Image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/product_image"
            android:scaleType="centerInside"
            android:src="@drawable/surmarket"
            />
    </androidx.cardview.widget.CardView>
    <Button
        android:id="@+id/BTN_FRGAddProduct_AddImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FRGAddProduct_BTNAddImage"
        android:textSize="@dimen/FRGButtonTextSize"
        android:textStyle="bold"
        android:layout_marginHorizontal="16sp"
        />
    <TextView
        android:id="@+id/TXV_FRGAddProduct_ProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FRGAddProduct_TXVProductName"
        android:textSize="16sp"
        android:textStyle="bold"
        />
    <EditText
        android:id="@+id/ETX_FRGAddProduct_ProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/FRGAddProduct_ETXProductName"
        android:textSize="16sp"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        />
    <TextView
        android:id="@+id/FRGAddProduct_ProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FRGAddProduct_TXVProductPrice"
        android:textSize="@dimen/FRGLabelTextSize"
        android:textStyle="bold"
        />
    <EditText
        android:id="@+id/FRGAddProduct_UserPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/FRGAddProduct_ETXProductPrice"
        android:textSize="@dimen/FRGEditTextTextSize"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"
        />
    <TextView
        android:id="@+id/FRGAddProduct_ProductStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FRGAddProduct_TXVProductStock"
        android:textSize="@dimen/FRGLabelTextSize"
        android:textStyle="bold"
        />
    <EditText
        android:id="@+id/FRGAddProduct_UserStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/FRGAddProduct_ETXProductStock"
        android:textSize="@dimen/FRGEditTextTextSize"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        />
    <TextView
        android:id="@+id/FRGAddProduct_ProductDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FRGAddProduct_TXVProductDescription"
        android:textSize="@dimen/FRGLabelTextSize"
        android:textStyle="bold"
        />
    <EditText
        android:id="@+id/FRGAddProduct_UserDescription"
        android:layout_width="match_parent"
        android:layout_height="@dimen/textView_multiline_height"
        android:textSize="@dimen/FRGEditTextTextSize"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:scrollbars="vertical"
        />
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
        >
    <com.google.android.material.chip.Chip
        android:id="@+id/CHP_FRGAddProduct_Varon"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/chip_margin_end"
        android:text="@string/category_men"
        android:textSize="16sp"
        />
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Women"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_Women"
            android:textSize="16sp"
            />

</LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Children"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_children"
            android:textSize="16sp"
            />
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Baby"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_baby"
            android:textSize="16sp"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Shoes"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_shoes"
            android:textSize="16sp"
            />
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Accessories"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_accessories"
            android:textSize="16sp"
            />
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Other"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/category_other"
            android:textSize="16sp"
            />

    </LinearLayout>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/CHG_FRGAddProduct_Availability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
    >
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Available"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/availabilily_available"
            android:textSize="16sp"
            />
        <com.google.android.material.chip.Chip
            android:id="@+id/CHP_FRGAddProduct_Not_Available"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/chip_margin_end"
            android:text="@string/availabilily_not_available"
            android:textSize="16sp"
            />
        <Button
            android:id="@+id/BTN_FRGAddProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGAddProduct_BTNAddProduct"
            android:textSize="@dimen/FRGButtonTextSize"
            android:textStyle="bold"
            android:layout_marginHorizontal="16sp"
            />

    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
    </ScrollView>
    </LinearLayout>

